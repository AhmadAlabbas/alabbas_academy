{
  "name": "@alabbas/platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build --webpack",
    "start": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "node --import tsx scripts/test-database.ts",
    "test:hostinger": "node --test scripts/test-hostinger-startup.mjs",
    "test:certificates": "node scripts/test-certificate-download.mjs",
    "test:theme-navigation": "node scripts/test-theme-navigation.mjs",
    "test:browser": "node scripts/test-browser-preview.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prepare:hostinger": "node scripts/package-hostinger.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "moyasar-payment-form": "2.3.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.0",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@swc/core": "1.16.0",
    "nodemailer": "$nodemailer",
    "mariadb": "3.5.4",
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  },
  "type": "module"
}
