# Private MySQL/MariaDB connection. Percent-encode special password characters.
DATABASE_URL="mysql://DB_USER:ENCODED_PASSWORD@localhost:3306/DB_NAME"
NEXT_PUBLIC_APP_URL="https://alabbasacademy.com"
AUTH_URL="https://alabbasacademy.com"
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Absolute persistent path outside .next, public, and the deployment directory.
UPLOAD_DIR="/home/YOUR_HOSTINGER_USER/academy-uploads"
# Hostinger supplies PORT. Keep this empty unless its application settings require it.
PORT="3001"
ACADEMY_HOST="0.0.0.0"
# Set only when your host replaces forwarded headers and prevents spoofing.
AUTH_TRUSTED_PROXY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# SMTP is the default. Switch only EMAIL_TRANSPORT to resend after setting its key.
EMAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Alabbas Academy <hello@alabbasacademy.com>"
ADMIN_EMAIL=""
RESEND_API_KEY=""
# Private seed credentials, 12–128 characters. Never commit or print real values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Academy Administrator"
# Keep false today. Gateway approval and all three keys are required for activation.
PAYMENTS_ENABLED="false"
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""
# Optional protected maintenance HTTP endpoints; no cron or daemon is required.
JOB_WORKER_SECRET=""
