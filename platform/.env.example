# Local development only. Replace this URL for staging and production.
# The credentials below match compose.yaml and are never production credentials.
DATABASE_URL="postgresql://academy:dev-only-academy@127.0.0.1:5560/academy?schema=public"

# Public origin only; this value can be included in browser assets.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Planned Phase 2 integrations. Keep secret values on the server.
AUTH_URL="http://localhost:3001"
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM=""

# Planned optional administrative seed. No account is created with a fixed password.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
SEED_ADMIN_NAME=""

# Planned Phase 4 Moyasar integration. Amounts are integer halalas in the database.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# Planned Phase 5 Bunny Stream integration. Never expose API/signing keys publicly.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME=""
BUNNY_STREAM_TOKEN_KEY=""

# Planned private file storage (S3-compatible provider).
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Planned job processing. Supply a separate random server-side authentication key.
JOB_WORKER_SECRET=""
