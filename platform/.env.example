# Local development only. Replace this URL for staging and production.
# The credentials below match compose.yaml and are never production credentials.
DATABASE_URL="postgresql://academy:dev-only-academy@127.0.0.1:5560/academy?schema=public"

# Public origin only; this value can be included in browser assets.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Accounts. Use the same canonical origin as NEXT_PUBLIC_APP_URL.
# In production both origins must use HTTPS, without a path or query string.
AUTH_URL="http://localhost:3001"
# Generate a private random secret of at least 32 characters. Never commit it.
AUTH_SECRET=""

# Optional Google sign-in. Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Account email delivery. Production requires Resend and a verified sender.
# For local development only, change EMAIL_TRANSPORT to "outbox"; messages are
# written privately under .local/mail/outbox. Outbox is rejected in production.
EMAIL_TRANSPORT="resend"
RESEND_API_KEY=""
EMAIL_FROM=""

# Separate private random secret of at least 32 characters for POST /api/jobs/email.
JOB_WORKER_SECRET=""

# Optional, outside Vercel: set to 1 only if a trusted reverse proxy replaces
# X-Forwarded-For and prevents clients from supplying that header themselves.
AUTH_TRUSTED_PROXY=""

# Optional administrative seed. No account is created with a fixed password.
# Supply email and password together; the password must contain 12–128 characters.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# Planned Phase 4 Moyasar integration. Amounts are integer halalas in the database.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# Planned Phase 5 Bunny Stream integration. Never expose API/signing keys publicly.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME=""
BUNNY_STREAM_TOKEN_KEY=""

# Planned private file storage (S3-compatible provider).
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
