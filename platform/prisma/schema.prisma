// Snapshot prevents editing a live exam from changing an already-started attempt.
model ExamAttempt {
  id             String @id @default(cuid()) @db.VarChar(191)
  enrollmentId   String @db.VarChar(191)
  examId         String @db.VarChar(191)
  number         Int
  passingBasisPoints Int @default(7000)
  examVersion    Int
  locale         String @db.VarChar(191)
  status         String @default("IN_PROGRESS") @db.VarChar(191)
  questionSnapshot Json
  answerSnapshot Json?
  scorePoints    Int?
  maximumPoints  Int
  passed         Boolean?
  startedAt      DateTime @default(now())
  expiresAt      DateTime?
  submittedAt    DateTime?
  gradedAt       DateTime?
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  exam           Exam @relation(fields: [examId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, examId, number])
  @@index([enrollmentId, startedAt])
  @@map("exam_attempts")
}

