generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// User-facing profiles and authentication secrets are intentionally separate.
model User {
  id                 String    @id @default(cuid()) @db.VarChar(191)
  name               String? @db.VarChar(191)
  email              String    @unique @db.VarChar(191)
  emailVerified      DateTime?
  image              String? @db.VarChar(191)
  passwordHash       String? @db.VarChar(191)
  preferredLocale    String    @default("ar") @db.VarChar(191)
  status             String @default("ACTIVE") @db.VarChar(191)
  sessionVersion     Int       @default(0)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  accounts           Account[]
  sessions           Session[]
  roles              UserRole[]
  emailTokens        EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  carts              Cart[]
  orders             Order[]
  reservations       CouponReservation[]
  redemptions        CouponRedemption[]
  enrollments        Enrollment[]
  reviews            Review[]
  auditLogs          AuditLog[]
  uploadedAssets     MediaAsset[]

  @@map("users")
}

model Role {
  id          String     @id @default(cuid()) @db.VarChar(191)
  slug        String     @unique @db.VarChar(191)
  name        String @db.VarChar(191)
  permissions Json @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String @db.VarChar(191)
  roleId    String @db.VarChar(191)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Account fields follow the Auth.js Prisma adapter contract. Google linking must
// prove ownership; provider emails alone must never merge existing identities.
model Account {
  id                String  @id @default(cuid()) @db.VarChar(191)
  userId            String @db.VarChar(191)
  type              String @db.VarChar(191)
  provider          String @db.VarChar(191)
  providerAccountId String @db.VarChar(191)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(191)
  scope             String? @db.VarChar(191)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(191)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Phase 2's session adapter must hash the browser token before storage.
model Session {
  id               String   @id @default(cuid()) @db.VarChar(191)
  tokenHash        String   @unique @db.Char(64)
  userId           String @db.VarChar(191)
  expires          DateTime
  revokedAt        DateTime?
  sessionVersion   Int
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
  @@index([expires])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(cuid()) @db.VarChar(191)
  userId     String @db.VarChar(191)
  email      String @db.VarChar(191)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid()) @db.VarChar(191)
  userId     String @db.VarChar(191)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// HMAC keys avoid persisting email addresses or source IPs in throttle storage.
// Counter increments and expired-window resets are atomic PostgreSQL upserts.
model AuthRateLimit {
  key       String   @id @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model Category {
 title_ar String @default("")
 title_en String @default("")
 description_ar String @default("") @db.Text
 description_en String @default("") @db.Text
  id           String   @id @default(cuid()) @db.VarChar(191)
  key          String   @unique @db.VarChar(191)
  parentId     String? @db.VarChar(191)
  position     Int      @default(0)
  tone         String   @default("sky") @db.VarChar(191)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  parent       Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("CategoryTree")
  translations CategoryTranslation[]
  courses      Course[]

  @@index([parentId, position])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(cuid()) @db.VarChar(191)
  categoryId  String @db.VarChar(191)
  locale      String @db.VarChar(191)
  slug        String @db.VarChar(191)
  title       String @db.VarChar(191)
  description String   @db.Text
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Tag {
  title_ar String @default("") @db.VarChar(191)
  title_en String @default("") @db.VarChar(191)
  id           String           @id @default(cuid()) @db.VarChar(191)
  key          String           @unique @db.VarChar(191)
  translations TagTranslation[]
  courses      CourseTag[]

  @@map("tags")
}

model TagTranslation {
  id     String @id @default(cuid()) @db.VarChar(191)
  tagId  String @db.VarChar(191)
  locale String @db.VarChar(191)
  slug   String @db.VarChar(191)
  title  String @db.VarChar(191)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@unique([locale, slug])
  @@map("tag_translations")
}

model CourseTag {
  courseId String @db.VarChar(191)
  tagId    String @db.VarChar(191)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([courseId, tagId])
  @@index([tagId])
  @@map("course_tags")
}

model Instructor {
 name_ar String @default("")
 name_en String @default("")
 bio_ar String @default("") @db.Text
 bio_en String @default("") @db.Text
 imageUrl String? @db.Text
  id           String   @id @default(cuid()) @db.VarChar(191)
  key          String   @unique @db.VarChar(191)
  initials     String @db.VarChar(191)
  imageAssetId String? @db.VarChar(191)
  websiteUrl   String? @db.VarChar(191)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  imageAsset   MediaAsset? @relation("InstructorImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  translations InstructorTranslation[]
  courses      CourseInstructor[]

  @@map("instructors")
}

model InstructorTranslation {
  id           String @id @default(cuid()) @db.VarChar(191)
  instructorId String @db.VarChar(191)
  locale       String @db.VarChar(191)
  name         String @db.VarChar(191)
  bio          String @db.Text
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, locale])
  @@map("instructor_translations")
}

model CourseInstructor {
  courseId     String @db.VarChar(191)
  instructorId String @db.VarChar(191)
  position     Int @default(0)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  @@id([courseId, instructorId])
  @@index([instructorId])
  @@map("course_instructors")
}

model Course {
 title_ar String @default("")
 title_en String @default("")
 slug_ar String @unique
 slug_en String @unique
 description_ar String @default("") @db.Text
 description_en String @default("") @db.Text
 outcomes_ar String @default("") @db.Text
 outcomes_en String @default("") @db.Text
 requirements_ar String @default("") @db.Text
 requirements_en String @default("") @db.Text
 seo_ar String @default("") @db.Text
 seo_en String @default("") @db.Text
 previewUrl String? @db.Text
 thumbnailUrl String? @db.Text
 isSample Boolean @default(false)
 languages String @default("ar,en")
  id                String       @id @default(cuid()) @db.VarChar(191)
  key               String       @unique @db.VarChar(191)
  categoryId        String @db.VarChar(191)
  status            String @default("DRAFT") @db.VarChar(191)
  level             String  @default("BEGINNER") @db.VarChar(191)
  currency          String       @default("SAR") @db.Char(3)
  priceHalalas      Int
  compareAtHalalas  Int?
  minutes           Int          @default(0)
  coverStyle        String       @default("design") @db.VarChar(191)
  coverAssetId      String? @db.VarChar(191)
  featured          Boolean      @default(false)
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverAsset        MediaAsset?  @relation("CourseCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  translations      CourseTranslation[]
  instructors       CourseInstructor[]
  tags              CourseTag[]
  sections          Section[]
  exams             Exam[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  couponCourses     CouponCourse[]
  enrollments       Enrollment[]
  reviews           Review[]

  @@index([status, featured, publishedAt])
  @@index([categoryId, status])
  @@map("courses")
}

model CourseTranslation {
  id               String @id @default(cuid()) @db.VarChar(191)
  courseId         String @db.VarChar(191)
  locale           String @db.VarChar(191)
  slug             String @db.VarChar(191)
  title            String @db.VarChar(191)
  description      String @db.Text
  learningOutcomes Json @default("[]")
  requirements     Json @default("[]")
  metaTitle        String? @db.VarChar(191)
  metaDescription  String? @db.VarChar(191)
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, locale])
  @@unique([locale, slug])
  @@map("course_translations")
}

model Section {
 title_ar String @default("")
 title_en String @default("")
  id           String @id @default(cuid()) @db.VarChar(191)
  courseId     String @db.VarChar(191)
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  translations SectionTranslation[]
  lessons      Lesson[]
  exams        Exam[]

  @@unique([courseId, position])
  @@map("sections")
}

model SectionTranslation {
  id        String @id @default(cuid()) @db.VarChar(191)
  sectionId String @db.VarChar(191)
  locale    String @db.VarChar(191)
  title     String @db.VarChar(191)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@map("section_translations")
}

model Lesson {
 title_ar String @default("")
 title_en String @default("")
 body_ar String @default("") @db.Text
 body_en String @default("") @db.Text
 videoUrl String? @db.Text
 videoFileId String?
 notesEnabled Boolean @default(true)
  id           String @id @default(cuid()) @db.VarChar(191)
  sectionId    String @db.VarChar(191)
  position     Int
  kind         String @default("ARTICLE") @db.VarChar(191)
  minutes      Int @default(0)
  isPreview    Boolean @default(false)
  isPublished  Boolean @default(false)
  videoAssetId String? @db.VarChar(191)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  section      Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  videoAsset   VideoAsset? @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)
  translations LessonTranslation[]
  attachments  LessonAttachment[]
  progress     LessonProgress[]

  @@unique([sectionId, position])
  @@index([videoAssetId])
  @@map("lessons")
}

model LessonTranslation {
  id       String @id @default(cuid()) @db.VarChar(191)
  lessonId String @db.VarChar(191)
  locale   String @db.VarChar(191)
  title    String @db.VarChar(191)
  body     String? @db.Text
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, locale])
  @@map("lesson_translations")
}

model MediaAsset {
  id                 String @id @default(cuid()) @db.VarChar(191)
  kind               String @db.VarChar(191)
  status             String @default("PENDING") @db.VarChar(191)
  storageKey         String @unique @db.VarChar(191)
  originalName       String @db.VarChar(191)
  mimeType           String @db.VarChar(191)
  bytes              BigInt
  checksumSha256     String? @db.Char(64)
  isPublic           Boolean @default(false)
  uploadedById       String? @db.VarChar(191)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  uploadedBy         User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  video              VideoAsset?
  courseCovers       Course[] @relation("CourseCover")
  instructorImages   Instructor[] @relation("InstructorImage")
  attachments        LessonAttachment[]
  testimonialImages  Testimonial[]
  certificates       Certificate[]

  @@index([status, createdAt])
  @@map("media_assets")
}

model VideoAsset {
  id              String @id @default(cuid()) @db.VarChar(191)
  mediaAssetId    String @unique @db.VarChar(191)
  provider        String @db.VarChar(191)
  providerVideoId String @db.VarChar(191)
  durationSeconds Int?
  status          String @default("PENDING") @db.VarChar(191)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mediaAsset      MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  lessons         Lesson[]

  @@unique([provider, providerVideoId])
  @@map("video_assets")
}

model LessonAttachment {
  id           String @id @default(cuid()) @db.VarChar(191)
  lessonId     String @db.VarChar(191)
  mediaAssetId String @db.VarChar(191)
  position     Int @default(0)
  labelAr      String @db.VarChar(191)
  labelEn      String @db.VarChar(191)
  lesson       Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([lessonId, mediaAssetId])
  @@map("lesson_attachments")
}

// Guest identifiers are random opaque tokens; store their SHA-256 digests.
model Cart {
  id             String @id @default(cuid()) @db.VarChar(191)
  userId         String? @unique @db.VarChar(191)
  guestTokenHash String? @unique @db.Char(64)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid()) @db.VarChar(191)
  cartId    String @db.VarChar(191)
  courseId  String @db.VarChar(191)
  createdAt DateTime @default(now())
  cart      Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
  @@map("cart_items")
}

// Order prices are immutable checkout snapshots, never joined to current prices.
model Order {
 provider String @default("manual")
 confirmationSentAt DateTime?
  id                  String @id @default(cuid()) @db.VarChar(191)
  number              String @unique @db.VarChar(191)
  userId              String @db.VarChar(191)
  status              String @default("PENDING") @db.VarChar(191)
  currency            String @default("SAR") @db.Char(3)
  subtotalHalalas      Int
  discountHalalas      Int @default(0)
  taxHalalas           Int @default(0)
  totalHalalas         Int
  buyerEmail           String @db.VarChar(191)
  buyerName            String @db.VarChar(191)
  locale               String @db.VarChar(191)
  couponCodeSnapshot   String? @db.VarChar(191)
  checkoutKey          String @unique @db.VarChar(191)
  expiresAt            DateTime?
  paidAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  paymentAttempts      PaymentAttempt[]
  refunds              Refund[]
  couponReservation    CouponReservation?
  couponRedemption     CouponRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String @id @default(cuid()) @db.VarChar(191)
  orderId           String @db.VarChar(191)
  courseId          String @db.VarChar(191)
  titleAr           String @db.VarChar(191)
  titleEn           String @db.VarChar(191)
  unitPriceHalalas  Int
  discountHalalas   Int @default(0)
  taxHalalas        Int @default(0)
  totalHalalas      Int
  createdAt         DateTime @default(now())
  order             Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  course            Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment        Enrollment?
  refundItems       RefundItem[]

  @@unique([orderId, courseId])
  @@index([courseId])
  @@map("order_items")
}

model PaymentAttempt {
  id                   String @id @default(cuid()) @db.VarChar(191)
  orderId              String @db.VarChar(191)
  provider             String @default("moyasar") @db.VarChar(191)
  providerPaymentId    String? @db.VarChar(191)
  idempotencyKey       String @unique @db.VarChar(191)
  status               String @default("CREATED") @db.VarChar(191)
  currency             String @default("SAR") @db.Char(3)
  amountHalalas        Int
  failureCode          String? @db.VarChar(191)
  failureMessage       String? @db.VarChar(191)
  verifiedAt           DateTime?
  capturedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  order                Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds              Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

// Only authenticated/verified webhooks may enter fulfillment. Unique provider
// event identifiers plus processing transactions make delivery duplicate-safe.
model WebhookEvent {
  id               String @id @default(cuid()) @db.VarChar(191)
  provider         String @db.VarChar(191)
  providerEventId  String @db.VarChar(191)
  eventType        String @db.VarChar(191)
  payloadHash      String @db.Char(64)
  payload          Json
  verifiedAt       DateTime?
  processedAt      DateTime?
  attempts         Int @default(0)
  lastError        String? @db.VarChar(191)
  receivedAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
  @@map("webhook_events")
}

model Refund {
  id               String @id @default(cuid()) @db.VarChar(191)
  orderId          String @db.VarChar(191)
  paymentAttemptId String @db.VarChar(191)
  providerRefundId String? @db.VarChar(191)
  idempotencyKey   String @unique @db.VarChar(191)
  amountHalalas    Int
  status           String @default("PENDING") @db.VarChar(191)
  reason           String @db.VarChar(191)
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  items            RefundItem[]

  @@unique([paymentAttemptId, providerRefundId])
  @@index([orderId])
  @@map("refunds")
}

model RefundItem {
  id            String @id @default(cuid()) @db.VarChar(191)
  refundId      String @db.VarChar(191)
  orderItemId   String @db.VarChar(191)
  amountHalalas Int
  revokeAccess  Boolean @default(true)
  refund        Refund @relation(fields: [refundId], references: [id], onDelete: Restrict)
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
  @@map("refund_items")
}

model Coupon {
  id                    String @id @default(cuid()) @db.VarChar(191)
  code                  String @unique @db.VarChar(191)
  kind                  String @db.VarChar(191)
  percentageBasisPoints Int?
  amountHalalas         Int?
  minimumOrderHalalas   Int @default(0)
  maximumDiscountHalalas Int?
  usageLimit            Int?
  perUserLimit          Int @default(1)
  isActive              Boolean @default(true)
  startsAt              DateTime?
  expiresAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  courses               CouponCourse[]
  reservations          CouponReservation[]
  redemptions           CouponRedemption[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponCourse {
  couponId String @db.VarChar(191)
  courseId String @db.VarChar(191)
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([couponId, courseId])
  @@index([courseId])
  @@map("coupon_courses")
}

model CouponReservation {
  id             String @id @default(cuid()) @db.VarChar(191)
  couponId       String @db.VarChar(191)
  orderId        String @unique @db.VarChar(191)
  userId         String @db.VarChar(191)
  status         String @default("RESERVED") @db.VarChar(191)
  discountHalalas Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  coupon         Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order          Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([couponId, status, expiresAt])
  @@index([userId, couponId])
  @@map("coupon_reservations")
}

model CouponRedemption {
  id              String @id @default(cuid()) @db.VarChar(191)
  couponId        String @db.VarChar(191)
  orderId         String @unique @db.VarChar(191)
  userId          String @db.VarChar(191)
  discountHalalas Int
  createdAt       DateTime @default(now())
  coupon          Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order           Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model Enrollment {
  id                 String @id @default(cuid()) @db.VarChar(191)
  userId             String @db.VarChar(191)
  courseId           String @db.VarChar(191)
  orderItemId        String? @unique @db.VarChar(191)
  status             String @default("ACTIVE") @db.VarChar(191)
  source             String @default("purchase") @db.VarChar(191)
  enrolledAt         DateTime @default(now())
  completedAt        DateTime?
  revokedAt          DateTime?
  user               User @relation(fields: [userId], references: [id], onDelete: Restrict)
  course             Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  orderItem          OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  progress           LessonProgress[]
  examAttempts       ExamAttempt[]
  certificate        Certificate?

  @@unique([userId, courseId])
  @@index([userId, status, enrolledAt])
  @@map("enrollments")
}

model LessonProgress {
